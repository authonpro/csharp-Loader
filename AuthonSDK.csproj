<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>AuthonSDK</RootNamespace>
    <AssemblyName>AuthonSDK</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <NoWarn>CA1416</NoWarn>

    <!-- Package Metadata -->
    <Version>2.0.0</Version>
    <Authors>Authon</Authors>
    <Company>Authon</Company>
    <Product>Authon C# SDK</Product>
    <Description>Official C# SDK for Authon — Software Licensing and Authentication Platform</Description>
    <PackageProjectUrl>https://authon.pro</PackageProjectUrl>
    <RepositoryUrl>https://github.com/authonpro</RepositoryUrl>
    <PackageTags>authon;licensing;authentication;sdk;hwid</PackageTags>
    <Copyright>Copyright © Authon 2024</Copyright>
  </PropertyGroup>

  <!-- System.Management for HWID generation (WMI) -->
  <ItemGroup>
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

</Project>
